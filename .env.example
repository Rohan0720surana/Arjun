# ARJUN — configuration
#
# Copy this file to `.env` and fill in what you have. Every single key below is
# optional: with an empty .env the system still boots, still detects, still
# records incidents and still shows the dashboard. Missing keys disable exactly
# one feature each and say so in the UI instead of crashing.
#
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)


# ===========================================================================
# CAMERAS
# ===========================================================================
# A comma separated list of  name=source  pairs.
#
#   0                          -> laptop webcam (any integer works)
#   http://192.168.1.7:4747/video   -> DroidCam on Android
#   http://192.168.1.7:8080/video   -> IP Webcam on Android
#   http://192.168.1.7:4747/mjpegfeed?640x480  -> DroidCam, forced size
#   rtsp://user:pass@192.168.1.9/stream1       -> a real CCTV camera
#   some/file.mp4              -> a video file, looped (good for rehearsing)
#   sim:atrium                 -> built-in simulated scene, no camera needed
#   sim:exam                   -> simulated exam hall
#
# The simulated sources exist so the whole system can be demonstrated on a
# laptop with no camera, and so a fall can be shown on stage without anyone
# actually falling over. They are labelled "Simulated" everywhere in the UI.
CAMERA_SOURCES=Main Corridor=0, Atrium (Simulated)=sim:atrium


# ===========================================================================
# PRIVACY
# ===========================================================================
# The PIN that unlocks the raw view of a camera and the incident clips.
# Every unlock is written to the audit log. Change this before a real pilot.
ADMIN_PIN=2026

# How many seconds of raw video are held in memory, per camera, at any moment.
# This buffer is never written to disk unless an incident fires.
RAW_BUFFER_SECONDS=15

# How much of the buffer an incident clip keeps, before and after the trigger.
CLIP_PRE_SECONDS=10
CLIP_POST_SECONDS=5

# Incident clips older than this are deleted automatically on startup.
CLIP_RETENTION_DAYS=7


# ===========================================================================
# ALERTS — TELEGRAM (primary, free, 2 minutes to set up)
# ===========================================================================
# 1. Message @BotFather on Telegram, send /newbot, copy the token.
# 2. Send any message to your new bot.
# 3. Open https://api.telegram.org/bot<TOKEN>/getUpdates and copy
#    result[0].message.chat.id
# Leave blank to disable Telegram; alerts still reach the dashboard.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ===========================================================================
# ALERTS — WHATSAPP via the Twilio sandbox (optional)
# ===========================================================================
# From the Twilio console: Messaging -> Try it out -> WhatsApp sandbox.
# Join the sandbox from your phone first, then paste the credentials.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_WHATSAPP_TO=

# WhatsApp can only attach an image it can reach over the public internet. If
# you are tunnelling the dashboard (ngrok, cloudflared), put the public URL
# here and the skeleton snapshot will be attached. Without it the WhatsApp
# message is text only.
PUBLIC_BASE_URL=


# ===========================================================================
# CLAUDE (natural-language search + automatic incident reports)
# ===========================================================================
# https://console.anthropic.com -> API keys.
# Without a key, "Ask your cameras" falls back to a local keyword search over
# the event database and incident reports are generated from a local template.
# Nothing breaks; the answers are just plainer.
CLAUDE_API_KEY=
CLAUDE_MODEL=claude-opus-5-5


# ===========================================================================
# PERFORMANCE (safe to ignore; tune only if the FPS readout disappoints you)
# ===========================================================================
PROC_WIDTH=640        # frames are resized to this width before inference
INFER_SIZE=416        # YOLO input size; 320 is faster, 512 is more accurate
TARGET_FPS=15         # per-camera capture ceiling
STREAM_FPS=12         # frames per second pushed to the browser
POSE_EVERY_N=2        # run the pose model on every Nth frame
JPEG_QUALITY=72       # dashboard stream quality
POSE_BACKEND=yolo     # yolo | mediapipe | off
TORCH_THREADS=0       # 0 = let torch pick; set to 2 or 4 on a busy laptop


# ===========================================================================
# MISC
# ===========================================================================
HOST=0.0.0.0
PORT=8000
OPEN_BROWSER=1        # open the dashboard in your browser on startup
DEMO_MODE=0           # 1 = short timers for a live demo
